  {
   "id": "brass",
   "icon": "ui/key_brass",
   "name": {
    "en": "Brass Key",
    "tr": "Pirinç Anahtar",
    "th": "กุญแจทองเหลือง"
   },
   "sources": {
    "en": "First clear of each place, every 3 debts paid in a run (up to 2 a run), lessons 3 and 6, daily goals, the weekly bonus.",
    "tr": "Her yerin ilk bitirişi, bir oyunda her 3 borç (oyun başına en çok 2), 3. ve 6. dersler, günlük hedefler, haftalık bonus.",
    "th": "ผ่านแต่ละด่านครั้งแรก ปลดหนี้ทุก 3 ก้อนในรอบเดียว (สูงสุด 2 ต่อรอบ) บทเรียนที่ 3 และ 6 เป้าหมายรายวัน โบนัสรายสัปดาห์"
   }
  },
  {
   "id": "silver",
   "icon": "ui/key_silver",
   "name": {
    "en": "Silver Key",
    "tr": "Gümüş Anahtar",
    "th": "กุญแจเงิน"
   },
   "sources": {
    "en": "Milestones, first clear of places 2, 5 and 7, the weekly contract, Storm clears, lesson 8, a 7-day streak.",
    "tr": "Kilometre taşları, 2., 5. ve 7. yerlerin ilk bitirişi, haftalık sözleşme, Fırtına bitirişleri, 8. ders, 7 günlük seri.",
    "th": "เหตุการณ์สำคัญ ผ่านด่าน 2, 5 และ 7 ครั้งแรก สัญญารายสัปดาห์ ผ่านพายุ บทเรียนที่ 8 เล่นต่อเนื่อง 7 วัน"
   }
  },
  {
   "id": "red",
   "icon": "ui/key_red",
   "name": {
    "en": "Red Key",
    "tr": "Kırmızı Anahtar",
    "th": "กุญแจแดง"
   },
   "sources": {
    "en": "Win a run with red cards from 3 different neighbours, the 5th red call in total, a gold stamp at place 9.",
    "tr": "3 farklı komşunun kırmızı kartlarıyla bir oyun kazan, toplam 5. kırmızı arama, 9. yerde altın mühür.",
    "th": "ชนะหนึ่งรอบโดยรับการ์ดแดงจากเพื่อนบ้าน 3 คนต่างกัน สายแดงครั้งที่ 5 รวม ตราทองที่ด่าน 9"
   }
  }
